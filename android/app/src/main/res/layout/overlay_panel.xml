<?xml version="1.0" encoding="utf-8"?>
<com.signo38.codiApp.overlay.PinchHostFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/overlay_pinch_host"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:clipChildren="false"
  android:clipToPadding="false">

  <LinearLayout
    android:id="@+id/overlay_root"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
      android:id="@+id/overlay_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingBottom="8dp">

      <TextView
        android:id="@+id/overlay_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="CODI APP"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

      <ImageButton
        android:id="@+id/overlay_minimize"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="Minimizar o expandir"
        android:padding="4dp"
        android:src="@android:drawable/arrow_down_float"
        android:tint="#FFFFFF" />

      <ImageButton
        android:id="@+id/overlay_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="Cerrar ventana flotante"
        android:padding="4dp"
        android:src="@android:drawable/ic_delete"
        android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingBottom="6dp">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Pistole → SAP (atrás)"
        android:textColor="#c8c8d0"
        android:textSize="11sp" />

      <Switch
        android:id="@+id/overlay_scanner_passthrough"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:contentDescription="Enviar escáner a la app de detrás" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
      android:id="@+id/overlay_scroll"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fillViewport="true"
      android:scrollbars="vertical">

      <LinearLayout
        android:id="@+id/overlay_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fila 1: texto + micrófono -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <EditText
            android:id="@+id/overlay_location"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Ubicación"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#6b6b6b" />

          <ImageButton
            android:id="@+id/overlay_mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="Dictado por voz"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Fila 2: Enter + Borrar (encima de “Código generado”) -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:gravity="center"
          android:orientation="horizontal">

          <Button
            android:id="@+id/overlay_enter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="42dp"
            android:paddingHorizontal="12dp"
            android:text="Enter"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2a2a40"
            android:contentDescription="Generar código" />

          <Button
            android:id="@+id/overlay_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="42dp"
            android:paddingHorizontal="12dp"
            android:text="Borrar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3a2a2a"
            android:contentDescription="Borrar texto y código" />
        </LinearLayout>

        <TextView
          android:id="@+id/overlay_generated_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:gravity="center"
          android:text="Código generado"
          android:textColor="#9a9aa3"
          android:textSize="12sp" />

        <ImageView
          android:id="@+id/overlay_barcode"
          android:layout_width="match_parent"
          android:layout_height="80dp"
          android:layout_marginTop="8dp"
          android:adjustViewBounds="true"
          android:scaleType="fitCenter" />

        <TextView
          android:id="@+id/overlay_generated_value"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="12sp" />

        <LinearLayout
          android:id="@+id/overlay_pull_section"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone"
          android:paddingTop="12dp">

          <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="#3a3a44" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoja de pull"
            android:textColor="#64d2ff"
            android:textSize="12sp"
            android:textStyle="bold" />

          <LinearLayout
            android:id="@+id/overlay_pull_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />
        </LinearLayout>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
  </LinearLayout>
</com.signo38.codiApp.overlay.PinchHostFrameLayout>
